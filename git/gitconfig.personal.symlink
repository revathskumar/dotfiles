[color]
	ui = true
[user]
	email = rsk@revathskumar.com
	name = Revath S Kumar
[core]
	autocrlf = input
	editor = vim
    ignorecase = false
    pager = delta
[rebase]
    autostash = true
[fetch]
    prune = true
[pull]
    ff = only
    default = current
    rebase = true
[stash]
    showPatch = true
[log]
    date = human
[delta]
    navigate = true
    light = false
[interactive]
    diffFilter = delta --color-only
[merge]
    conflictstyle = diff3
[alias]
    d = diff
    ds = diff --staged
    amend = commit --amend --no-edit
    plz = push --force-with-lease
	lg = log --color --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
    yday = !sh -c 'git shortlog --since=yesterday --author=rsk@revathskumar.com --no-merges'
    promote = !$DOTFILES/bin/git-promote
    wtf     = !$DOTFILES/bin/git-wtf
    rank-contributers = !$DOTFILES/bin/git-rank-contributers
    count   = !git shortlog -sn
    today = !sh -c 'git shortlog --since=6am --author=rsk@revathskumar.com --no-merges'
    ignored = !git ls-files -v | grep "^[[:lower:]]"
    pr = !hub pull-request -b master -h `git rev-parse --abbrev-ref HEAD`
    hpr = !hub pull-request -b production-release-v1 -h `git rev-parse --abbrev-ref HEAD`
[help]
  autocorrect = 1
[url "https://"]
	insteadOf = git://
[filter "lfs"]
	clean = git-lfs clean %f
	smudge = git-lfs smudge %f
	required = true
[commit]
	gpgSign = true
[cinnabar]
	helper = /home/revath/code/git-cinnabar/git-cinnabar-helper
[pager]
	branch = false
[init]
	defaultBranch = main
